<?xml version="1.0" encoding="utf-8"?>
<!-- FieldRow：標籤＋值＋動作，每個動作是獨立的 IconButton。根元素是 ui.FieldRow -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- 標籤與值合成一個 TalkBack 焦點（內容描述由 FieldRow 設定） -->
    <LinearLayout
        android:id="@+id/sv_field_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/sv_space_sm"
        android:layout_weight="1"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingVertical="@dimen/sv_space_sm">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:importantForAccessibility="no"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sv_field_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- 「已複製」標記：圖示＋文字，不只靠顏色 -->
            <TextView
                android:id="@+id/sv_field_copied"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/sv_space_sm"
                android:drawablePadding="@dimen/sv_space_xs"
                android:gravity="center_vertical"
                android:importantForAccessibility="no"
                android:text="@string/sv_field_copied"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="@color/sv_success"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/sv_ic_check_circle"
                app:drawableTint="@color/sv_success" />
        </LinearLayout>

        <TextView
            android:id="@+id/sv_field_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurface" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sv_field_reveal"
        style="@style/Widget.SVault.IconButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:icon="@drawable/sv_ic_visibility" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sv_field_open"
        style="@style/Widget.SVault.IconButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:icon="@drawable/sv_ic_open_in_new" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sv_field_copy"
        style="@style/Widget.SVault.IconButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:icon="@drawable/sv_ic_content_copy" />
</merge>
