<?xml version="1.0" encoding="utf-8"?>
<!-- 最近開啟清單的一列：保管庫名稱＋最後開啟時間，整列可點；「更多選項」鈕獨立可點（從清單移除） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/sv_row_min_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/sv_space_lg"
    android:paddingEnd="@dimen/sv_space_xs">

    <ImageView
        android:layout_width="@dimen/sv_icon"
        android:layout_height="@dimen/sv_icon"
        android:importantForAccessibility="no"
        android:src="@drawable/sv_ic_lock"
        app:tint="?attr/colorOnSurfaceVariant" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/sv_space_lg"
        android:layout_marginEnd="@dimen/sv_space_sm"
        android:layout_weight="1"
        android:importantForAccessibility="no"
        android:orientation="vertical"
        android:paddingVertical="@dimen/sv_space_sm">

        <TextView
            android:id="@+id/recent_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/recent_opened"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/recent_more"
        style="@style/Widget.SVault.IconButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:icon="@drawable/sv_ic_more_vert" />
</LinearLayout>
